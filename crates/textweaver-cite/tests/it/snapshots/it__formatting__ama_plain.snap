style: AMA Manual of Style 11th edition
citations:
  [@kucsko2013] => [1]
  [@dahl1988, p. 12] => [2(p12)]
  [see @smyth2007, pp. 5-6; also @vangogh2020] => see [3(pp5–6)], also [4]
  @muller2019 [chap. 3] => [5(chap3)]
  [@who2021; -@access2024] => [6],[7]
  [@nobody2000] => missing reference nobody2000
missing: nobody2000
