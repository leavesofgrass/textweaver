---
source: crates/textweaver-cite/tests/formatting.rs
expression: "render(\"vancouver\", OutputFormat :: Plain)"
---
style: Elsevier - NLM/Vancouver (citation-sequence)
citations:
  [@kucsko2013] => [1]
  [@dahl1988, p. 12] => [2]
  [see @smyth2007, pp. 5-6; also @vangogh2020] => [see 3, also 4]
  @muller2019 [chap. 3] => Müller J [5]
  [@who2021; -@access2024] => [6,7]
  [@nobody2000] => [missing reference nobody2000]
missing: nobody2000
