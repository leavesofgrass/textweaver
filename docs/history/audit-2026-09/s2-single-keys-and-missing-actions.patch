@@ -117,6 +117,24 @@ impl App {
         self.tell(&format!("Theme {}.", next.replace('-', " ")));
     }
 
+    /// Turns single-key shortcuts on or off (WCAG 2.1.4); every command
+    /// stays reachable through a modifier chord or the command palette.
+    pub(crate) fn toggle_character_keys(&mut self) {
+        let on = !self.keymap.character_keys();
+        self.keymap.set_character_keys(on);
+        self.settings.keyboard.character_keys = on;
+        self.settings_dirty = true;
+        self.say_at(
+            if on {
+                "Single-key shortcuts on."
+            } else {
+                "Single-key shortcuts off."
+            },
+            textweaver_a11y::Verbosity::Low,
+            textweaver_a11y::Priority::Assertive,
+        );
+    }
+
     pub(crate) fn toggle_line_numbers(&mut self) {
         let on = !self.settings.display.show_line_numbers;
         self.settings.display.show_line_numbers = on;
