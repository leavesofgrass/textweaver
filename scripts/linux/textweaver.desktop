[Desktop Entry]
Type=Application
Version=1.5
Name=textweaver
GenericName=Talking document reader
Comment=Read documents aloud, with a highlight that follows the spoken word
Exec=textweaver %f
TryExec=textweaver
Terminal=true
Icon=accessories-text-editor
Categories=Office;Viewer;Utility;Accessibility;
MimeType=text/plain;text/markdown;text/x-markdown;text/html;application/xhtml+xml;application/epub+zip;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/pdf;
Keywords=speech;screen reader;text to speech;read aloud;Markdown;EPUB;dyslexia;
StartupNotify=false
