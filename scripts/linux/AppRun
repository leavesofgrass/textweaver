#!/bin/sh
# AppRun: the entry point of the textweaver AppImage (docs/install.md).
#
# One AppImage holds one program, textweaver: the app by default, and the
# terminal program (tw) with --tw or --cli first, when started as tw, or
# when the first argument is a tw command such as convert. The program
# decides that itself; this script only maps the AppImage's names:
# - through a link named tw: the program as tw, so tw FILE opens the
#   terminal reader and tw COMMAND runs a command;
# - --gui or --app first: the app (kept for menu entries and scripts made
#   before beta 3, which started the app as textweaver-gui);
# - --textweaver first: the terminal program, for menu entries made by
#   AppImages before beta 3, when textweaver opened the terminal reader;
# - anything else, including links named textweaver or textweaver-gui:
#   textweaver itself.
#
# Desktop integration:
# - --install [--yes]: after asking, links textweaver and tw in
#   ~/.local/bin to this AppImage, and adds menu entries for the app and
#   the terminal reader, and an icon. It removes the textweaver-gui link
#   and menu entry an earlier --install made.
# - --uninstall [--yes]: removes what --install made.
#
# The AppImage runtime's own options (--appimage-extract-and-run,
# --appimage-help, and the rest) are handled before this script runs.

set -eu

HERE="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
LIB="$HERE/usr/lib/textweaver"
SELF="${APPIMAGE:-}"

say() { printf '%s\n' "$*"; }

# Warns when the ALSA library, which textweaver needs for sound, is
# missing. Every desktop has it; a bare container may not.
check_alsa() {
  if command -v ldconfig > /dev/null 2>&1 && ldconfig -p 2> /dev/null | grep -q 'libasound\.so\.2'; then
    return 0
  fi
  if [ -x /sbin/ldconfig ] && /sbin/ldconfig -p 2> /dev/null | grep -q 'libasound\.so\.2'; then
    return 0
  fi
  for d in /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib64 /lib64 /usr/lib /lib \
    /usr/lib/aarch64-linux-gnu /lib/aarch64-linux-gnu; do
    [ -e "$d/libasound.so.2" ] && return 0
  done
  say "textweaver needs the ALSA sound library, libasound.so.2, and it was not found." >&2
  say "Install it with your package manager: alsa-lib on Fedora, Arch, and openSUSE; libasound2 (or libasound2t64) on Debian and Ubuntu." >&2
}

# Asks a yes-or-no question; --yes answers yes, and no terminal answers no.
ASSUME_YES=0
ask() {
  if [ "$ASSUME_YES" = 1 ]; then
    say "$1 Answering yes, because of --yes."
    return 0
  fi
  if [ ! -t 0 ]; then
    say "$1 Answering no, because there is no terminal to ask on. Add --yes to answer yes."
    return 1
  fi
  printf '%s Type y for yes or n for no, then press Enter: ' "$1"
  reply=""
  read -r reply || reply=""
  case $reply in
    [Yy] | [Yy][Ee][Ss]) return 0 ;;
    *) return 1 ;;
  esac
}

BIN_DIR="$HOME/.local/bin"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
APPS_DIR="$DATA_DIR/applications"
ICON_DIR="$DATA_DIR/icons/hicolor/scalable/apps"
DESKTOP="$APPS_DIR/textweaver.desktop"
TERMINAL_DESKTOP="$APPS_DIR/textweaver-terminal.desktop"
# The app's menu entry as --install wrote it before beta 3.
OLD_GUI_DESKTOP="$APPS_DIR/textweaver-gui.desktop"
MARKER="X-textweaver-AppImage=true"
NAMES="textweaver tw"
# The app's link as --install made it before beta 3.
OLD_NAMES="textweaver-gui"

need_appimage() {
  if [ -z "$SELF" ]; then
    say "$1 works when textweaver runs as an AppImage file." >&2
    exit 2
  fi
}

# Removes the link $BIN_DIR/$1 when it points at an AppImage; any other
# file or link is left, and named.
remove_link() {
  link="$BIN_DIR/$1"
  if [ -L "$link" ]; then
    target="$(readlink "$link")"
    case $target in
      *.AppImage | "$SELF")
        rm -f "$link"
        say "Removed $link."
        ;;
      *) say "Leaving $link: it points at $target, not at an AppImage." ;;
    esac
  fi
}

# Removes the menu entry $1 when --install wrote it (it has the marker).
remove_entry() {
  if [ -f "$1" ] && grep -q "^$MARKER\$" "$1"; then
    rm -f "$1"
    say "Removed the menu entry $1."
  fi
}

integrate() {
  need_appimage "--install"
  say "This links textweaver and tw to this AppImage, $SELF:"
  say "- the programs $BIN_DIR/textweaver (the app) and $BIN_DIR/tw (the terminal reader and commands);"
  say "- menu entries for the app and the terminal reader, $DESKTOP and $TERMINAL_DESKTOP;"
  say "- the icon, $ICON_DIR/textweaver.svg."
  say "The links point at the AppImage where it is now. If you want to keep it somewhere else, move it first, then run --install again."
  if ! ask "Install?"; then
    say "Nothing changed."
    return 0
  fi
  mkdir -p "$BIN_DIR" "$APPS_DIR" "$ICON_DIR"
  for name in $NAMES; do
    if [ -e "$BIN_DIR/$name" ] && [ ! -L "$BIN_DIR/$name" ]; then
      say "Leaving $BIN_DIR/$name: it is a file, not a link. Remove it, then run --install again."
    else
      ln -sfn "$SELF" "$BIN_DIR/$name"
      say "Linked $BIN_DIR/$name."
    fi
  done
  # textweaver is the app now; the textweaver-gui link and entry go.
  for name in $OLD_NAMES; do
    remove_link "$name"
  done
  remove_entry "$OLD_GUI_DESKTOP"
  cp "$HERE/textweaver.svg" "$ICON_DIR/textweaver.svg"
  say "Installed the icon."
  sed -e "s|^Exec=.*|Exec=\"$SELF\" %f|" -e '/^TryExec=/d' "$HERE/usr/share/applications/textweaver.desktop" > "$DESKTOP"
  printf '%s\n' "$MARKER" >> "$DESKTOP"
  sed -e "s|^Exec=.*|Exec=\"$SELF\" --tw %f|" -e '/^TryExec=/d' "$HERE/usr/share/applications/textweaver-terminal.desktop" > "$TERMINAL_DESKTOP"
  printf '%s\n' "$MARKER" >> "$TERMINAL_DESKTOP"
  say "Wrote the menu entries."
  if command -v update-desktop-database > /dev/null 2>&1; then
    update-desktop-database "$APPS_DIR" > /dev/null 2>&1 || true
  fi
  case ":$PATH:" in
    *":$BIN_DIR:"*) say "Done. Run textweaver (the app) or tw (the terminal reader and commands) from any folder." ;;
    *)
      say "Done. $BIN_DIR is not on your PATH yet. Add this line to your shell's startup file, such as ~/.bashrc, then open a new terminal:"
      say "  export PATH=\"\$HOME/.local/bin:\$PATH\""
      ;;
  esac
}

unintegrate() {
  if ! ask "Remove the textweaver and tw links, the menu entries, and the icon that --install made?"; then
    say "Nothing changed."
    return 0
  fi
  for name in $NAMES $OLD_NAMES; do
    remove_link "$name"
  done
  for entry in "$DESKTOP" "$TERMINAL_DESKTOP" "$OLD_GUI_DESKTOP"; do
    remove_entry "$entry"
  done
  if [ -f "$ICON_DIR/textweaver.svg" ]; then
    rm -f "$ICON_DIR/textweaver.svg"
    say "Removed the icon."
  fi
  say "Done. The AppImage file itself is still at ${SELF:-its place}; delete it to remove textweaver. Your settings and reading positions are kept."
}

# The name this was started as: the AppImage runtime passes the link or
# file name in ARGV0. Started as tw, the program runs through its own tw
# link, so it sees that name; --tw and --cli it handles itself.
name="$(basename "${ARGV0:-$0}")"
program=textweaver
case $name in
  tw | tw.*) program=tw ;;
esac

case "${1:-}" in
  --gui | --app)
    shift
    program=textweaver
    ;;
  --textweaver)
    shift
    program=tw
    ;;
  --install | --uninstall)
    action="$1"
    shift
    for a in "$@"; do
      case $a in
        --yes | -y) ASSUME_YES=1 ;;
        *)
          say "Unknown option $a. Use: --install [--yes] or --uninstall [--yes]." >&2
          exit 2
          ;;
      esac
    done
    if [ "$action" = --install ]; then integrate; else unintegrate; fi
    exit 0
    ;;
esac

check_alsa
exec "$LIB/$program" "$@"
